<?xml version="1.0" encoding="UTF-8"?>
<!--
  DDS Windows Platform — WiX v4 MSI Bundle
  Installs:
    1. dds-node.exe          (Rust, Windows Service)
    2. DDS Auth Bridge        (C++, Windows Service)
    3. DDS Credential Provider (C++, COM DLL)
    4. DdsPolicyAgent         (.NET, Windows Service)
    5. DDS Tray Agent          (C++, optional)
    6. Configuration files

  Build variables (passed via -d on wix command line):
    BuildDir   — path to staged binaries for the target platform
    ConfigDir  — path to configuration templates
    Platform   — "x64" or "arm64"
    Version    — e.g. "1.0.0.0"
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!-- ============================================================ -->
  <!-- Platform detection: set InstallerPlatform to "x64" or "arm64" -->
  <!-- and pick the correct ProgramFiles folder                      -->
  <!-- ============================================================ -->
  <?ifdef Platform ?>
    <?if $(var.Platform) = "arm64" ?>
      <?define InstallerPlatform = "arm64" ?>
      <?define ProductName = "DDS Windows Platform (ARM64)" ?>
    <?else ?>
      <?define InstallerPlatform = "x64" ?>
      <?define ProductName = "DDS Windows Platform (x64)" ?>
    <?endif ?>
  <?else ?>
    <?define InstallerPlatform = "x64" ?>
    <?define ProductName = "DDS Windows Platform (x64)" ?>
  <?endif ?>

  <?ifndef Version ?>
    <?define Version = "1.0.0.0" ?>
  <?endif ?>

  <Package Name="$(var.ProductName)"
           Manufacturer="DDS"
           Version="$(var.Version)"
           UpgradeCode="F1A2B3C4-D5E6-7890-ABCD-123456789012"
           Compressed="yes"
           InstallerVersion="500">

    <!-- Schedule="afterInstallExecute": the new product installs FIRST,
         then the old product is removed. This is the standard MSI
         pattern for preserving operator-customized config files across
         upgrades. Combined with NeverOverwrite+Permanent on the two
         config components below, it means:
           1. New product installs. NeverOverwrite skips replacing the
              existing node.toml + appsettings.json.
           2. Old product uninstalls. Permanent="yes" tells MSI not to
              remove those two components.
           3. Result: operator-customized configs survive every upgrade. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of DDS is already installed."
                  Schedule="afterInstallExecute" />
    <MediaTemplate EmbedCab="yes" />

    <!-- ============================================================ -->
    <!-- Install directory layout                                     -->
    <!-- ============================================================ -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="DDS">
        <Directory Id="DIR_BIN" Name="bin" />
        <Directory Id="DIR_CONFIG" Name="config" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="System64Folder" />

    <!-- %ProgramData%\DDS\ for vault, logs, applied-state -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DIR_APPDATA_DDS" Name="DDS" />
    </StandardDirectory>

    <!-- Start menu folder for shortcuts -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="DIR_STARTMENU_DDS" Name="DDS" />
    </StandardDirectory>

    <!-- ============================================================ -->
    <!-- Feature: Core (dds-node)                                     -->
    <!-- ============================================================ -->
    <Feature Id="F_Core" Title="DDS Node" Description="Core P2P directory service daemon" Level="1">
      <ComponentGroupRef Id="CG_DdsNode" />
      <ComponentGroupRef Id="CG_AppData" />
    </Feature>

    <!-- ============================================================ -->
    <!-- Feature: Auth Bridge (C++ service + CTAP2 engine)            -->
    <!-- ============================================================ -->
    <Feature Id="F_AuthBridge" Title="DDS Auth Bridge" Description="FIDO2 authentication bridge for Windows logon" Level="1">
      <ComponentGroupRef Id="CG_AuthBridge" />
    </Feature>

    <!-- ============================================================ -->
    <!-- Feature: Credential Provider (COM DLL)                       -->
    <!-- ============================================================ -->
    <Feature Id="F_CredProv" Title="DDS Credential Provider" Description="Windows logon credential provider" Level="1">
      <ComponentGroupRef Id="CG_CredProv" />
    </Feature>

    <!-- ============================================================ -->
    <!-- Feature: Policy Agent (.NET service)                         -->
    <!-- ============================================================ -->
    <Feature Id="F_PolicyAgent" Title="DDS Policy Agent" Description="Windows policy enforcement agent" Level="1">
      <ComponentGroupRef Id="CG_PolicyAgent" />
    </Feature>

    <!-- ============================================================ -->
    <!-- Feature: Tray Agent (optional, C++)                          -->
    <!-- ============================================================ -->
    <Feature Id="F_TrayAgent" Title="DDS Tray Agent" Description="System tray notification agent" Level="1">
      <ComponentGroupRef Id="CG_TrayAgent" />
    </Feature>

    <!-- ============================================================ -->
    <!-- Feature: DDS CLI (dds.exe + machine PATH entry)              -->
    <!-- ============================================================ -->
    <Feature Id="F_Cli" Title="DDS CLI" Description="The 'dds' command-line tool, plus DDS\bin on the machine PATH" Level="1">
      <ComponentGroupRef Id="CG_DdsCli" />
    </Feature>

    <!-- ============================================================ -->
    <!-- Feature: Onboarding Wizard helper (file association +        -->
    <!-- per-user auto-launch via Active Setup, plus dds-enroll-user) -->
    <!-- ============================================================ -->
    <Feature Id="F_OnboardingWizard" Title="DDS Onboarding Wizard" Description="Guided setup + per-user auto-launch + .dds file association" Level="1">
      <ComponentGroupRef Id="CG_EnrollUser" />
      <ComponentGroupRef Id="CG_DdsFileAssoc" />
      <ComponentGroupRef Id="CG_ActiveSetup" />
    </Feature>

    <!-- ============================================================ -->
    <!-- Feature: Start menu shortcuts + bootstrap script             -->
    <!-- ============================================================ -->
    <Feature Id="F_Shortcuts" Title="Start Menu Shortcuts" Description="DDS folder in Start menu (Bootstrap, Tray Agent)" Level="1">
      <ComponentGroupRef Id="CG_BootstrapScript" />
      <ComponentGroupRef Id="CG_StartMenuShortcuts" />
    </Feature>

    <!-- ============================================================ -->
    <!-- Component: dds-node.exe                                      -->
    <!-- ============================================================ -->
    <ComponentGroup Id="CG_DdsNode" Directory="DIR_BIN">
      <Component Id="C_DdsNode" Guid="11111111-1111-1111-1111-111111111111">
        <File Id="dds_node_exe" Source="$(var.BuildDir)\dds-node.exe" KeyPath="yes" />
        <!-- Stamp the installed version so the tray and Console can
             display it (HKLM\Software\DDS\Version, REG_SZ). Co-located
             on C_DdsNode (always installed via F_Core) rather than its
             own component to keep the registry write tied to a feature
             that is guaranteed present. -->
        <RegistryValue Root="HKLM"
                       Key="Software\DDS"
                       Name="Version"
                       Type="string"
                       Value="$(var.Version)" />
        <ServiceInstall Id="SI_DdsNode"
                        Name="DdsNode"
                        DisplayName="DDS Node"
                        Description="DDS distributed directory service"
                        Type="ownProcess"
                        Start="auto"
                        Account="LocalSystem"
                        ErrorControl="normal"
                        Arguments="service-run --config &quot;[DIR_CONFIG]node.toml&quot; --unseal-passphrase-from &quot;[CommonAppDataFolder]DDS\node-passphrase.dpapi&quot;" />
        <!-- Start="install" Wait="no": auto-start on every install AND
             upgrade so the operator doesn't have to manually Start-Service
             after each MSI. Wait="no" is critical for the fresh-install
             case: the shipped node.toml is an unprovisioned template
             without a [domain] section, dds-node refuses to load it with a
             TOML parse error, and the service exits — but because we
             don't wait, MSI ignores it and the install still succeeds.
             The user then runs the onboarding wizard (auto-launched via
             Active Setup) which writes a real config and the service
             comes up cleanly. On an UPGRADE the existing operator
             node.toml is preserved by NeverOverwrite+Permanent on
             C_DdsNodeConfig, so the start succeeds immediately. -->
        <ServiceControl Id="SC_DdsNode"
                        Name="DdsNode"
                        Stop="both"
                        Start="install"
                        Remove="uninstall"
                        Wait="no" />
      </Component>
      <!-- node.toml is install-once / preserve-forever:
           * NeverOverwrite="yes" — install only if file doesn't exist.
           * Permanent="yes"      — never removed by uninstall or by
                                    MajorUpgrade's RemoveExistingProducts.
           Combined with MajorUpgrade Schedule="afterInstallExecute"
           above, the operator's customized node.toml survives every
           upgrade. (If you really need to ship a new template, change
           the path or rename so it lands as a new file.) -->
      <Component Id="C_DdsNodeConfig" Guid="22222222-2222-2222-2222-222222222222" Directory="DIR_CONFIG" NeverOverwrite="yes" Permanent="yes">
        <File Id="node_config_toml" Source="$(var.ConfigDir)\node.toml" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- ============================================================ -->
    <!-- Component: DDS Auth Bridge service                           -->
    <!-- ============================================================ -->
    <ComponentGroup Id="CG_AuthBridge" Directory="DIR_BIN">
      <Component Id="C_AuthBridge" Guid="33333333-3333-3333-3333-333333333333">
        <File Id="auth_bridge_exe" Source="$(var.BuildDir)\DdsAuthBridge.exe" KeyPath="yes" />
        <ServiceInstall Id="SI_AuthBridge"
                        Name="DdsAuthBridge"
                        DisplayName="DDS Auth Bridge"
                        Description="DDS FIDO2 authentication bridge for Windows logon"
                        Type="ownProcess"
                        Start="auto"
                        Account="LocalSystem"
                        ErrorControl="normal">
          <ServiceDependency Id="DdsNode" />
          <!-- NgcSvc (Microsoft Passport) hosts the WebAuthn UI broker that
               WebAuthNAuthenticatorGetAssertion DCOM-activates from the
               secure desktop. NgcSvc ships as StartType=Manual on Win10/11
               and is otherwise only started on demand once a user session
               uses Windows Hello — never from LogonUI's pre-login context.
               Without it running, the broker activation fails with
               CO_E_RUNAS_LOGON_FAILURE (0x8000401A) and the FIDO2 tile
               dies before the security key is ever contacted.
               Declaring NgcSvc as a SCM dependency makes the SCM start it
               before DdsAuthBridge during boot, so by the time LogonUI
               loads our credential provider the broker can activate. -->
          <ServiceDependency Id="NgcSvc" />
        </ServiceInstall>
        <!-- Start="install" Wait="no": see SC_DdsNode. Windows SCM honors
             the ServiceDependency above and waits for DdsNode to enter
             Running before kicking off DdsAuthBridge, so we don't need
             ordering logic here. If DdsNode isn't actually serving on a
             fresh install, DdsAuthBridge will fail too — but Wait="no"
             keeps the MSI quiet. -->
        <ServiceControl Id="SC_AuthBridge"
                        Name="DdsAuthBridge"
                        Stop="both"
                        Start="install"
                        Remove="uninstall"
                        Wait="no" />

        <!-- **H-6 step-2 (security review)**: tell the Auth Bridge
             where to find the per-install HMAC secret generated below
             by CA_GenHmacSecret. -->
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\DDS\AuthBridge"
                       Name="HmacSecretPath"
                       Value="[CommonAppDataFolder]DDS\node-hmac.key"
                       Type="expandable" />

        <!-- **A-2 (security review)**: select the named-pipe transport
             added in H-7 step-2b by default. The Rust dds-node.toml
             template installed alongside this MSI declares
             `api_addr = "pipe:dds-api"`, so the Auth Bridge has to
             dial the same pipe rather than the loopback TCP listener
             (which the hardened config disables). Operators who want
             to keep the legacy TCP path can remove this value or set
             it to "http://127.0.0.1:5551" via group policy. -->
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\DDS\AuthBridge"
                       Name="ApiAddr"
                       Value="pipe:dds-api"
                       Type="string" />

        <!-- Product version stamp. Read by DdsConsole.ps1 and the tray
             agent so they can show the installed MSI version without
             querying the Windows Installer ARP table (which is slow and
             can mismatch when a side-by-side runtime build is launched
             from a dev tree). -->
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\DDS"
                       Name="Version"
                       Value="$(var.Version)"
                       Type="string" />
      </Component>
    </ComponentGroup>

    <!-- ============================================================ -->
    <!-- Threat-model §3 / open item #8: Custom action — apply a       -->
    <!-- restrictive DACL to %ProgramData%\DDS so subsequently created -->
    <!-- vault / HMAC secret / applied-state / log files inherit       -->
    <!-- LocalSystem + BUILTIN\Administrators only. Without this,      -->
    <!-- %ProgramData%\DDS inherits BUILTIN\Users:Read from its parent -->
    <!-- on most Windows SKUs and CA_GenHmacSecret would write the     -->
    <!-- per-install HMAC secret into a world-readable directory.      -->
    <!--                                                                -->
    <!-- Defense-in-depth: the C++ Auth Bridge also self-heals this    -->
    <!-- DACL on every service start (FileLog::Init), and the .NET     -->
    <!-- Policy Agent applies the same DACL to the staging cache and   -->
    <!-- to applied-state.json (B-6 / L-16). The MSI custom action     -->
    <!-- closes the install-time race so even files written *before*   -->
    <!-- those services first start are protected.                     -->
    <!-- ============================================================ -->
    <CustomAction Id="CA_RestrictDataDirAcl"
                  FileRef="dds_node_exe"
                  ExeCommand='restrict-data-dir-acl --data-dir "[CommonAppDataFolder]DDS"'
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!-- ============================================================ -->
    <!-- H-6 step-2: Custom action — generate the per-install HMAC    -->
    <!-- secret on first install. Runs `dds-node.exe gen-hmac-secret` -->
    <!-- which writes 32 random bytes at the target path unless a     -->
    <!-- file already exists (so reinstalls / repairs do not rotate   -->
    <!-- the secret and desynchronise the Auth Bridge from the node). -->
    <!-- Deferred execution + Impersonate="no" => runs as LocalSystem,-->
    <!-- matching the service accounts that will read the file later. -->
    <!-- ============================================================ -->
    <CustomAction Id="CA_GenHmacSecret"
                  FileRef="dds_node_exe"
                  ExeCommand='gen-hmac-secret --keep-existing --out "[CommonAppDataFolder]DDS\node-hmac.key"'
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!-- ============================================================ -->
    <!-- SC-3-W (security review 2026-04-28): Custom action — stamp   -->
    <!-- the node Ed25519 pubkey into the Policy Agent's              -->
    <!-- appsettings.json before the DdsPolicyAgent service first     -->
    <!-- starts. The agent's Program.cs fails closed on an empty      -->
    <!-- PinnedNodePubkeyB64, so without this stamp the SCM auto-     -->
    <!-- start would crash-loop on every fresh MSI install until an   -->
    <!-- operator either ran single-file `dds-node provision` or      -->
    <!-- hand-edited the JSON. Runs `dds-node.exe stamp-agent-pubkey` -->
    <!-- which loads (or creates, on first install) %ProgramData%\DDS-->
    <!-- \node_key.bin, derives the base64 pubkey, and rewrites the   -->
    <!-- DdsPolicyAgent.PinnedNodePubkeyB64 field in place — every    -->
    <!-- other appsettings key (Logging, NodeBaseUrl, StateDir, the   -->
    <!-- empty DeviceUrn placeholder) is preserved. DeviceUrn cannot  -->
    <!-- be stamped here: it is only known after enrollment with a    -->
    <!-- domain, which is *not* part of the MSI install path —        -->
    <!-- operators run `dds-bootstrap-domain` (or single-file         -->
    <!-- provisioning) post-install to populate it.                   -->
    <!--                                                                -->
    <!-- Deferred + Impersonate="no" so the action runs as LocalSystem-->
    <!-- and the freshly-created node_key.bin inherits the protected  -->
    <!-- DACL applied above by CA_RestrictDataDirAcl.                 -->
    <!-- ============================================================ -->
    <CustomAction Id="CA_StampAgentPubkey"
                  FileRef="dds_node_exe"
                  ExeCommand='stamp-agent-pubkey --data-dir "[CommonAppDataFolder]DDS" --config-dir "[INSTALLFOLDER]config"'
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!-- ============================================================ -->
    <!-- Flip NgcSvc (Microsoft Passport Container) StartType=Manual  -->
    <!-- → Automatic so it survives idle timeouts and reboots. The    -->
    <!-- ServiceDependency in CG_AuthBridge only gates *bridge start*;-->
    <!-- once both are running the SCM is free to stop NgcSvc when    -->
    <!-- nothing else is using it (Hello-less Home SKUs idle it out   -->
    <!-- within hours), and every subsequent secure-desktop WebAuthn  -->
    <!-- call then fails immediately with CO_E_RUNAS_LOGON_FAILURE   -->
    <!-- (0x8000401A) until something restarts it. Auto start type    -->
    <!-- keeps the broker available for LogonUI across the full       -->
    <!-- machine lifecycle.                                            -->
    <!--                                                                -->
    <!-- The bridge also re-kicks NgcSvc per challenge (DdsAuth-      -->
    <!-- BridgeMain.cpp::HandleDdsStartAuth) as the runtime safety    -->
    <!-- net for legacy installs and operator/policy overrides.       -->
    <!--                                                                -->
    <!-- Return="ignore": skip silently on Windows SKUs that lack    -->
    <!-- NgcSvc (Server Core, LTSC variants) — install must not       -->
    <!-- fail just because the service is missing.                    -->
    <!-- ============================================================ -->
    <CustomAction Id="CA_SetNgcSvcAuto"
                  Directory="DIR_BIN"
                  ExeCommand='"[SystemFolder]sc.exe" config NgcSvc start= auto'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Note: auto-launch of the onboarding wizard for the installing user
         is handled by Active Setup (CG_ActiveSetup below): on the next
         interactive logon Windows replays the StubPath into HKCU and
         fires the wizard once per user. This avoids the cross-WiX-version
         fragility of UtilExtension's WixShellExec custom action; the only
         downside is the installing user has to log off/on once after a
         fresh install. Subsequent users are caught automatically. -->

    <InstallExecuteSequence>
      <!-- Run after the files are laid down (so dds-node.exe exists)
           and the data dir is created (so we have something to ACL),
           but before CA_GenHmacSecret so node-hmac.key is created
           underneath the already-restricted DACL — it would otherwise
           inherit the wide-open %ProgramData% ACL at write time and
           keep that ACL even after we tighten the parent. -->
      <Custom Action="CA_RestrictDataDirAcl" After="InstallFiles" Condition="NOT REMOVE" />
      <!-- Run after the files are laid down (so dds-node.exe exists)
           and the service accounts are created (so the directory is
           writable), but before the services start (so dds-node and
           the Auth Bridge both see the same secret on first boot). -->
      <Custom Action="CA_GenHmacSecret" After="CA_RestrictDataDirAcl" Condition="NOT REMOVE" />
      <!-- SC-3-W: stamp the agent pubkey after node_key.bin can be
           written under the restricted DACL but before service start
           so the DdsPolicyAgent service finds the pinning field
           populated on its first run. Sequence after CA_GenHmacSecret
           so a single re-entrant deferred phase covers all three
           helpers. -->
      <Custom Action="CA_StampAgentPubkey" After="CA_GenHmacSecret" Condition="NOT REMOVE" />
      <!-- Set NgcSvc StartType=Automatic before the bridge service starts
           so the WebAuthn UI broker is reliably available the first time
           LogonUI invokes our credential provider. Sequenced last among
           the deferred CAs so it shares the same elevated phase. -->
      <Custom Action="CA_SetNgcSvcAuto" After="CA_StampAgentPubkey" Condition="NOT REMOVE" />
    </InstallExecuteSequence>

    <!-- ============================================================ -->
    <!-- Component: DDS Credential Provider DLL                       -->
    <!-- ============================================================ -->
    <!-- ICE09 warns about non-permanent System32 component; this is intentional
         for credential providers — they must live in System32 for logonui.exe -->
    <ComponentGroup Id="CG_CredProv" Directory="System64Folder">
      <!-- 1.1.7 fix: bumped Guid from ...44 to ...45 so the credential
           provider DLL is treated as a NEW component by MSI on upgrade,
           forcing the new build to land on disk. With the original fixed
           GUID + Permanent="yes", MSI treated the component as "already
           installed permanently" and silently skipped replacing the
           DLL — leaving every operator on the May 4 build for weeks of
           1.1.x upgrades. The DLL has no VERSIONINFO resource, so MSI
           had no way to detect that the source differed from the target.
           Keeping Permanent="yes" preserves the original ICE09 intent
           (logonui.exe never sees the file vanish on uninstall).

           1.5.0 fix: bumped ...45 -> ...46. The 1.5.0 upgrade over 1.4.2
           reproduced the exact skip (still ...45 + Permanent + no version
           resource), so the Stage-2 credential provider had to be copied
           into System32 by hand. This GUID MUST be bumped on every release
           that changes DdsCredentialProvider.dll until the DLL carries a
           real VERSIONINFO resource (the durable fix — then MSI can detect
           source-vs-target differences and this whole dance goes away). -->
      <Component Id="C_CredProvDll" Guid="44444444-4444-4444-4444-444444444446" Permanent="yes">
        <File Id="credprov_dll" Source="$(var.BuildDir)\DdsCredentialProvider.dll" KeyPath="yes" />

        <!-- COM registration: HKCR\CLSID\{...}\InprocServer32 -->
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Classes\CLSID\{a7f3b2c1-9d4e-4f8a-b6c5-2e1d0a3f7b9c}"
                       Value="DDS Credential Provider"
                       Type="string" />
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Classes\CLSID\{a7f3b2c1-9d4e-4f8a-b6c5-2e1d0a3f7b9c}\InprocServer32"
                       Value="[System64Folder]DdsCredentialProvider.dll"
                       Type="expandable" />
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Classes\CLSID\{a7f3b2c1-9d4e-4f8a-b6c5-2e1d0a3f7b9c}\InprocServer32"
                       Name="ThreadingModel"
                       Value="Apartment"
                       Type="string" />

        <!-- Credential Provider registration -->
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Authentication\Credential Providers\{a7f3b2c1-9d4e-4f8a-b6c5-2e1d0a3f7b9c}"
                       Value="DdsCredentialProvider"
                       Type="string" />
      </Component>
    </ComponentGroup>

    <!-- ============================================================ -->
    <!-- Component: DDS Policy Agent (.NET)                           -->
    <!-- ============================================================ -->
    <ComponentGroup Id="CG_PolicyAgent" Directory="DIR_BIN">
      <Component Id="C_PolicyAgent" Guid="55555555-5555-5555-5555-555555555555">
        <File Id="policy_agent_exe" Source="$(var.BuildDir)\DdsPolicyAgent.exe" KeyPath="yes" />
        <!-- contentRoot points at DIR_CONFIG (not INSTALLFOLDER) so the
             .NET Generic Host's default appsettings.json lookup lands on
             C_PolicyAgentConfig below. Earlier revisions pointed at
             INSTALLFOLDER, leaving appsettings.json one directory away
             from where Host.CreateApplicationBuilder searched — the
             DdsPolicyAgent:PinnedNodePubkeyB64 binding then came back
             empty and the H-2 fail-closed guard in Program.cs crashed
             the service on every SCM start. CA_StampAgentPubkey already
             writes to [INSTALLFOLDER]config, so this aligns the read
             path with the write path. -->
        <ServiceInstall Id="SI_PolicyAgent"
                        Name="DdsPolicyAgent"
                        DisplayName="DDS Policy Agent"
                        Description="DDS Windows policy enforcement agent"
                        Type="ownProcess"
                        Start="auto"
                        Account="LocalSystem"
                        ErrorControl="normal"
                        Arguments="--contentRoot &quot;[INSTALLFOLDER]config&quot;">
          <ServiceDependency Id="DdsNode" />
        </ServiceInstall>
        <!-- Start="install" Wait="no": same pattern as SC_DdsNode/SC_AuthBridge. -->
        <ServiceControl Id="SC_PolicyAgent"
                        Name="DdsPolicyAgent"
                        Stop="both"
                        Start="install"
                        Remove="uninstall"
                        Wait="no" />
      </Component>
      <!-- appsettings.json: same NeverOverwrite + Permanent pattern as
           C_DdsNodeConfig. Carries DeviceUrn (only known after
           enroll-device) and PinnedNodePubkeyB64 (re-stamped by
           CA_StampAgentPubkey post-install). -->
      <Component Id="C_PolicyAgentConfig" Guid="88888888-8888-8888-8888-888888888888" Directory="DIR_CONFIG" NeverOverwrite="yes" Permanent="yes">
        <File Id="policy_agent_appsettings" Source="$(var.ConfigDir)\appsettings.json" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- ============================================================ -->
    <!-- Component: DDS Tray Agent (optional)                         -->
    <!-- ============================================================ -->
    <ComponentGroup Id="CG_TrayAgent" Directory="DIR_BIN">
      <Component Id="C_TrayAgent" Guid="77777777-7777-7777-7777-777777777777">
        <File Id="tray_agent_exe" Source="$(var.BuildDir)\DdsTrayAgent.exe" KeyPath="yes" />
      </Component>
      <!-- HKLM Run key: launch tray for every interactive logon (all users   -->
      <!-- on the machine). The minimized flag suppresses any first-run UI;   -->
      <!-- single-instance mutex prevents duplicates if the user also opens   -->
      <!-- the Start-menu shortcut.                                           -->
      <Component Id="C_TrayAgentAutostart" Guid="78787878-7878-7878-7878-787878787878">
        <RegistryValue Root="HKLM"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="DdsTrayAgent"
                       Type="string"
                       Value='"[#tray_agent_exe]" --minimized'
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- ============================================================ -->
    <!-- Component: dds CLI (Rust) + machine PATH entry               -->
    <!-- ============================================================ -->
    <ComponentGroup Id="CG_DdsCli" Directory="DIR_BIN">
      <Component Id="C_DdsCli" Guid="EAEAEAEA-EAEA-EAEA-EAEA-EAEAEAEAEAEA">
        <File Id="dds_cli_exe" Source="$(var.BuildDir)\dds.exe" KeyPath="yes" />
        <!-- Append DDS\bin to the machine PATH so `dds` and the other
             helper binaries are runnable from any shell after install.
             Action="set" Part="last" appends; System="yes" writes the
             machine-wide PATH (HKLM\...\Session Manager\Environment)
             rather than the installing user's. Permanent="no" so the
             entry is removed on uninstall, keeping PATH clean. Bound
             to the dds.exe component so installing F_Cli adds PATH and
             uninstalling F_Cli removes it as a single atomic change. -->
        <Environment Id="E_PathDdsBin"
                     Name="PATH"
                     Action="set"
                     Part="last"
                     System="yes"
                     Permanent="no"
                     Value="[DIR_BIN]" />
      </Component>
    </ComponentGroup>

    <!-- ============================================================ -->
    <!-- Component: ProgramData directory for vault + state           -->
    <!-- ============================================================ -->
    <ComponentGroup Id="CG_AppData" Directory="DIR_APPDATA_DDS">
      <Component Id="C_AppDataDir" Guid="66666666-6666-6666-6666-666666666666">
        <CreateFolder />
      </Component>
    </ComponentGroup>

    <!-- ============================================================ -->
    <!-- Component: Bootstrap-DdsDomain.ps1 + wizard helpers in DIR_BIN -->
    <!-- ============================================================ -->
    <ComponentGroup Id="CG_BootstrapScript" Directory="DIR_BIN">
      <Component Id="C_BootstrapScript" Guid="99999999-9999-9999-9999-999999999999">
        <File Id="bootstrap_script_ps1"
              Source="$(var.BuildDir)\Bootstrap-DdsDomain.ps1"
              KeyPath="yes" />
      </Component>
      <Component Id="C_DdsConsoleScript" Guid="C0C0C0C0-C0C0-C0C0-C0C0-C0C0C0C0C0C0">
        <File Id="dds_console_ps1"
              Source="$(var.BuildDir)\DdsConsole.ps1"
              KeyPath="yes" />
      </Component>
      <Component Id="C_GetOnboardingState" Guid="D1D1D1D1-D1D1-D1D1-D1D1-D1D1D1D1D1D1">
        <File Id="state_probe_ps1"
              Source="$(var.BuildDir)\Get-DdsOnboardingState.ps1"
              KeyPath="yes" />
      </Component>
      <Component Id="C_EnrollDeviceScript" Guid="D2D2D2D2-D2D2-D2D2-D2D2-D2D2D2D2D2D2">
        <File Id="enroll_device_ps1"
              Source="$(var.BuildDir)\Enroll-DdsDevice.ps1"
              KeyPath="yes" />
      </Component>
      <Component Id="C_ResetBootstrapScript" Guid="D3D3D3D3-D3D3-D3D3-D3D3-D3D3D3D3D3D3">
        <File Id="reset_bootstrap_ps1"
              Source="$(var.BuildDir)\Reset-DdsBootstrap.ps1"
              KeyPath="yes" />
      </Component>
      <Component Id="C_UninstallScript" Guid="D4D4D4D4-D4D4-D4D4-D4D4-D4D4D4D4D4D4">
        <File Id="uninstall_ps1"
              Source="$(var.BuildDir)\Uninstall-Dds.ps1"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- ============================================================ -->
    <!-- Component: dds-enroll-user.exe (CLI helper for Branch C of   -->
    <!-- the wizard — non-interactive FIDO2 enrollment with NDJSON    -->
    <!-- status piped back to DdsConsole.ps1).                         -->
    <!-- ============================================================ -->
    <ComponentGroup Id="CG_EnrollUser" Directory="DIR_BIN">
      <Component Id="C_EnrollUser" Guid="E1E1E1E1-E1E1-E1E1-E1E1-E1E1E1E1E1E1">
        <File Id="dds_enroll_user_exe"
              Source="$(var.BuildDir)\dds-enroll-user.exe"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- ============================================================ -->
    <!-- Component: .dds file association                             -->
    <!-- Double-click a *.dds provision bundle → wizard opens in      -->
    <!-- Branch B (Join Domain) with the bundle pre-loaded.           -->
    <!-- ============================================================ -->
    <ComponentGroup Id="CG_DdsFileAssoc" Directory="INSTALLFOLDER">
      <Component Id="C_DdsFileAssoc" Guid="E2E2E2E2-E2E2-E2E2-E2E2-E2E2E2E2E2E2">
        <!-- Extension → ProgId -->
        <RegistryValue Root="HKLM"
                       Key="Software\Classes\.dds"
                       Value="DDS.ProvisionBundle"
                       Type="string"
                       KeyPath="yes" />
        <RegistryValue Root="HKLM"
                       Key="Software\Classes\.dds"
                       Name="Content Type"
                       Value="application/x-dds-bundle"
                       Type="string" />

        <!-- ProgId metadata -->
        <RegistryValue Root="HKLM"
                       Key="Software\Classes\DDS.ProvisionBundle"
                       Value="DDS Provision Bundle"
                       Type="string" />
        <RegistryValue Root="HKLM"
                       Key="Software\Classes\DDS.ProvisionBundle\DefaultIcon"
                       Value='[DIR_BIN]DdsConsole.ps1'
                       Type="expandable" />

        <!-- Open verb: launch the wizard pre-pointed at Branch B with the
             dropped bundle path. PowerShell quoting on %1 is handled by the
             outer double-quotes around the script path. -->
        <RegistryValue Root="HKLM"
                       Key="Software\Classes\DDS.ProvisionBundle\shell\open\command"
                       Value='"[System64Folder]WindowsPowerShell\v1.0\powershell.exe" -NoProfile -ExecutionPolicy Bypass -File "[DIR_BIN]DdsConsole.ps1" -Mode JoinDomain -BundlePath "%1"'
                       Type="expandable" />
      </Component>
    </ComponentGroup>

    <!-- ============================================================ -->
    <!-- Component: Active Setup — runs DdsConsole.ps1 once per user  -->
    <!-- on first interactive logon after install. The Active Setup   -->
    <!-- mechanism replays HKLM commands into HKCU for each user the  -->
    <!-- first time they log on, so we get a single auto-launch       -->
    <!-- without needing per-user RunOnce keys at install time.       -->
    <!--                                                                -->
    <!-- Bumping `Version` re-fires the StubPath for every user.       -->
    <!-- ============================================================ -->
    <ComponentGroup Id="CG_ActiveSetup" Directory="INSTALLFOLDER">
      <Component Id="C_ActiveSetupOnboard" Guid="E3E3E3E3-E3E3-E3E3-E3E3-E3E3E3E3E3E3">
        <RegistryValue Root="HKLM"
                       Key="Software\Microsoft\Active Setup\Installed Components\{F1A2B3C4-DDS0-0000-0000-DDSONBOARD01}"
                       Value="DDS Onboarding Wizard"
                       Type="string"
                       KeyPath="yes" />
        <RegistryValue Root="HKLM"
                       Key="Software\Microsoft\Active Setup\Installed Components\{F1A2B3C4-DDS0-0000-0000-DDSONBOARD01}"
                       Name="Version"
                       Value="1,0,0,0"
                       Type="string" />
        <RegistryValue Root="HKLM"
                       Key="Software\Microsoft\Active Setup\Installed Components\{F1A2B3C4-DDS0-0000-0000-DDSONBOARD01}"
                       Name="StubPath"
                       Value='"[System64Folder]WindowsPowerShell\v1.0\powershell.exe" -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "[DIR_BIN]DdsConsole.ps1" -Mode Auto'
                       Type="expandable" />
        <RegistryValue Root="HKLM"
                       Key="Software\Microsoft\Active Setup\Installed Components\{F1A2B3C4-DDS0-0000-0000-DDSONBOARD01}"
                       Name="IsInstalled"
                       Value="1"
                       Type="integer" />
      </Component>
    </ComponentGroup>

    <!-- ============================================================ -->
    <!-- Component: Start menu shortcuts                              -->
    <!--   - "DDS Bootstrap Domain" → powershell.exe + script (UAC)    -->
    <!--   - "DDS Tray Agent"       → DdsTrayAgent.exe                 -->
    <!-- Each shortcut component uses an HKCU RegistryValue as KeyPath -->
    <!-- (per-user advertised marker required by WiX for non-advertised -->
    <!-- shortcuts to per-machine target files).                       -->
    <!-- ============================================================ -->
    <ComponentGroup Id="CG_StartMenuShortcuts" Directory="DIR_STARTMENU_DDS">
      <Component Id="C_ShortcutBootstrap" Guid="A0A0A0A0-A0A0-A0A0-A0A0-A0A0A0A0A0A0">
        <Shortcut Id="SH_Bootstrap"
                  Name="DDS Bootstrap Domain"
                  Description="Initialize a new DDS domain on this machine (touch your FIDO2 key)"
                  Target="[System64Folder]WindowsPowerShell\v1.0\powershell.exe"
                  Arguments='-NoProfile -ExecutionPolicy Bypass -File "[DIR_BIN]Bootstrap-DdsDomain.ps1"'
                  WorkingDirectory="DIR_BIN" />
        <RemoveFolder Id="RF_StartMenuDdsBootstrap" Directory="DIR_STARTMENU_DDS" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\DDS\Shortcuts"
                       Name="Bootstrap"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
      <Component Id="C_ShortcutTrayAgent" Guid="B0B0B0B0-B0B0-B0B0-B0B0-B0B0B0B0B0B0">
        <Shortcut Id="SH_TrayAgent"
                  Name="DDS Tray Agent"
                  Description="DDS user enrollment, vault refresh, and admin tray agent"
                  Target="[DIR_BIN]DdsTrayAgent.exe"
                  WorkingDirectory="DIR_BIN" />
        <RegistryValue Root="HKCU"
                       Key="Software\DDS\Shortcuts"
                       Name="TrayAgent"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
      <Component Id="C_ShortcutConsole" Guid="C1C1C1C1-C1C1-C1C1-C1C1-C1C1C1C1C1C1">
        <Shortcut Id="SH_Console"
                  Name="DDS Console"
                  Description="DDS bootstrap wizard + service health view (WPF)"
                  Target="[System64Folder]WindowsPowerShell\v1.0\powershell.exe"
                  Arguments='-NoProfile -ExecutionPolicy Bypass -File "[DIR_BIN]DdsConsole.ps1"'
                  WorkingDirectory="DIR_BIN" />
        <RegistryValue Root="HKCU"
                       Key="Software\DDS\Shortcuts"
                       Name="Console"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

  </Package>
</Wix>
